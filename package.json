{
  "name": "guard-online-admin",
  "version": "1.0.0",
  "description": "护航单在线后台管理系统",
  "author": "护航单后台",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prod": "NODE_ENV=production node server.js",
    "desktop": "electron .",
    "package:win": "electron-packager . 护航单后台 --platform=win32 --arch=x64 --out=dist --overwrite --app-version=1.0.0",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^31.7.1",
    "electron-builder": "^24.13.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.guard.admin",
    "productName": "护航单后台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!tests/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "护航单后台-${version}-portable.${ext}",
      "signAndEditExecutable": false,
      "sign": null
    }
  }
}
